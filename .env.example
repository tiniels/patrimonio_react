# Copy to the deployment provider's encrypted environment configuration.
# Never commit a populated .env file.
# Blank values are intentional. Production values belong only in Vercel or another approved secret store.

# Runtime
APP_ENV=
APP_BASE_URL=

# Identity provider (server only)
# local-admin is a temporary bootstrap provider until institutional OIDC is approved.
AUTH_PROVIDER=
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_CALLBACK_URL=
SESSION_SECRET=
AUTH_SESSION_VERSION=
AUTH_SESSION_MAX_AGE_SECONDS=

# Temporary administrative bootstrap identity (server only)
# Never store a plain password. Use pbkdf2_sha256$iterations$saltBase64Url$hashBase64Url.
ADMIN_BOOTSTRAP_ID=
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD_HASH=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
ADMIN_BOOTSTRAP_ROLE=
ADMIN_BOOTSTRAP_ROLE_LABEL=
ADMIN_BOOTSTRAP_CARGO=
ADMIN_BOOTSTRAP_SECRETARIA=
ADMIN_BOOTSTRAP_SETOR=
ADMIN_BOOTSTRAP_CODIGO_SETOR=
ADMIN_BOOTSTRAP_EMAIL=

# Data layer (server only)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Observability (server only)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Security controls
# Keep true until every required server-side variable is configured and the production validation is approved.
AUTH_LOCKDOWN_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=
AUTH_RATE_LIMIT_MAX_ATTEMPTS=
